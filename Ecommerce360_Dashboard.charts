{"exportVersion":10,"dashboards":{"dashboard-1":{"title":"E-Commerce 360° — Real-Time Operations (CLK · OMS · PMS · IMS)","layout":[{"w":2,"h":1,"x":0,"y":0,"i":"item-1"},{"w":2,"h":1,"x":2,"y":0,"i":"item-2"},{"w":2,"h":1,"x":4,"y":0,"i":"item-3"},{"w":2,"h":1,"x":6,"y":0,"i":"item-4"},{"w":2,"h":1,"x":0,"y":1,"i":"item-5"},{"w":2,"h":1,"x":2,"y":1,"i":"item-6"},{"w":2,"h":1,"x":4,"y":1,"i":"item-7"},{"w":2,"h":1,"x":6,"y":1,"i":"item-8"},{"w":8,"h":2,"x":0,"y":2,"i":"item-9"},{"w":4,"h":2,"x":0,"y":4,"i":"item-10"},{"w":4,"h":2,"x":4,"y":4,"i":"item-11"},{"w":4,"h":2,"x":0,"y":6,"i":"item-12"},{"w":4,"h":2,"x":4,"y":6,"i":"item-13"},{"w":4,"h":2,"x":0,"y":8,"i":"item-14"},{"w":4,"h":2,"x":4,"y":8,"i":"item-15"},{"w":4,"h":2,"x":0,"y":10,"i":"item-16"},{"w":4,"h":2,"x":4,"y":10,"i":"item-17"},{"w":4,"h":2,"x":0,"y":12,"i":"item-18"},{"w":4,"h":2,"x":4,"y":12,"i":"item-19"},{"w":4,"h":2,"x":0,"y":14,"i":"item-20"},{"w":4,"h":2,"x":4,"y":14,"i":"item-21"},{"w":4,"h":2,"x":0,"y":16,"i":"item-22"},{"w":4,"h":2,"x":4,"y":16,"i":"item-23"},{"w":4,"h":2,"x":0,"y":18,"i":"item-24"},{"w":4,"h":2,"x":4,"y":18,"i":"item-25"},{"w":4,"h":2,"x":0,"y":20,"i":"item-26"},{"w":4,"h":2,"x":4,"y":20,"i":"item-27"},{"w":4,"h":2,"x":0,"y":22,"i":"item-28"},{"w":4,"h":2,"x":4,"y":22,"i":"item-29"},{"w":4,"h":2,"x":0,"y":24,"i":"item-30"},{"w":4,"h":2,"x":4,"y":24,"i":"item-31"},{"w":4,"h":2,"x":0,"y":26,"i":"item-32"},{"w":4,"h":2,"x":4,"y":26,"i":"item-33"}],"description":"One dashboard over four streaming systems: Website Clickstream, Order Management, Payment Management and Inventory Management, joined through the journey_orders collection. Charts are ordered from first principles — base counts first, derived rates only after the data they are computed from. Numbered titles give the reading order.","embedding":{"anonymousAuthEnabled":false},"filters":[{"disabled":false,"type":"String","settings":{"allOthers":true,"values":[]},"name":"Category","linkedFields":[{"dataSourceId":"data-source-2","fieldPath":"category"},{"dataSourceId":"data-source-1","fieldPath":"category"},{"dataSourceId":"data-source-5","fieldPath":"category"},{"dataSourceId":"data-source-9","fieldPath":"category"}]},{"disabled":false,"type":"String","settings":{"allOthers":true,"values":[]},"name":"City","linkedFields":[{"dataSourceId":"data-source-2","fieldPath":"city"},{"dataSourceId":"data-source-1","fieldPath":"city"},{"dataSourceId":"data-source-4","fieldPath":"city"}]},{"disabled":false,"type":"String","settings":{"allOthers":true,"values":[]},"name":"Warehouse","linkedFields":[{"dataSourceId":"data-source-2","fieldPath":"warehouse_id"},{"dataSourceId":"data-source-1","fieldPath":"warehouse_id"},{"dataSourceId":"data-source-9","fieldPath":"warehouse_id"}]},{"disabled":false,"type":"String","settings":{"allOthers":true,"values":[]},"name":"Device","linkedFields":[{"dataSourceId":"data-source-4","fieldPath":"device"},{"dataSourceId":"data-source-2","fieldPath":"device"}]}]}},"items":{"item-1":{"title":"Events Ingested (all systems)","description":"BASE. Every message the analytics consumer read from all 14 Kafka topics across CLK, OMS, PMS and IMS.","dashboardId":"dashboard-1","dataSourceId":"data-source-1","iconValue":"number","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[],"channels":{"value":{"field":"_id","type":"quantitative","inferredType":"String","channelType":"aggregation","aggregate":"count"}},"reductions":{},"customisations":{"options":{},"axes":{},"channels":{"value":{"labelOverride":{"enabled":true,"value":"Events Ingested (all systems)"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"0"}}},"conditionalFormatting":[]},"chartType":"Number","meta":{},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"7be1e9b6-aae3-4a4d-828e-99987b7b19c4"}},"item-2":{"title":"Shopper Sessions","description":"BASE. Distinct sessions seen by the clickstream system. Top of the funnel — the denominator for conversion.","dashboardId":"dashboard-1","dataSourceId":"data-source-4","iconValue":"number","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[],"channels":{"value":{"field":"_id","type":"quantitative","inferredType":"String","channelType":"aggregation","aggregate":"count"}},"reductions":{},"customisations":{"options":{},"axes":{},"channels":{"value":{"labelOverride":{"enabled":true,"value":"Shopper Sessions"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"0"}}},"conditionalFormatting":[]},"chartType":"Number","meta":{},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"91e71fdf-86d9-4522-9451-9baeddb0558e"}},"item-3":{"title":"Orders Created","description":"BASE. Orders the OMS created from checkout intent. One document per order in journey_orders.","dashboardId":"dashboard-1","dataSourceId":"data-source-2","iconValue":"number","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[],"channels":{"value":{"field":"_id","type":"quantitative","inferredType":"String","channelType":"aggregation","aggregate":"count"}},"reductions":{},"customisations":{"options":{},"axes":{},"channels":{"value":{"labelOverride":{"enabled":true,"value":"Orders Created"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"0"}}},"conditionalFormatting":[]},"chartType":"Number","meta":{},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"3d5681ef-48aa-41dc-b41f-1ecb76a6cf0b"}},"item-4":{"title":"Checkout Conversion (%)","description":"DERIVED = sessions that reached checkout ÷ all sessions × 100. Built from the two KPIs to the left.","dashboardId":"dashboard-1","dataSourceId":"data-source-4","iconValue":"number","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[{"fieldPath":"pct_reached_checkout","rawExpression":"{\n  \"$multiply\": [\n    {\n      \"$ifNull\": [\n        \"$reached_checkout\",\n        0\n      ]\n    },\n    100\n  ]\n}","derivedMQL":"{\"$multiply\":[{\"$ifNull\":[\"$reached_checkout\",0]},100]}"}],"channels":{"value":{"field":"pct_reached_checkout","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"mean"}},"reductions":{},"customisations":{"options":{},"axes":{},"channels":{"value":{"labelOverride":{"enabled":true,"value":"Checkout Conversion (%)"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"1"}}},"conditionalFormatting":[]},"chartType":"Number","meta":{},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"5928bc28-0fc7-419d-8330-e822bffbbdd8"}},"item-5":{"title":"Revenue Retained (₹)","description":"BASE. Order value of orders that were actually delivered and kept.","dashboardId":"dashboard-1","dataSourceId":"data-source-2","iconValue":"number","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[],"channels":{"value":{"field":"retained_revenue","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"sum"}},"reductions":{},"customisations":{"options":{},"axes":{},"channels":{"value":{"labelOverride":{"enabled":true,"value":"Revenue Retained (₹)"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"0"}}},"conditionalFormatting":[]},"chartType":"Number","meta":{},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"5573f5a4-f27b-4be6-9563-6eb544b44c5a"}},"item-6":{"title":"Revenue Lost (₹)","description":"BASE. Order value lost to payment failure, stock-out cancellation or post-delivery return. Attribution in 3.2.","dashboardId":"dashboard-1","dataSourceId":"data-source-2","iconValue":"number","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[],"channels":{"value":{"field":"lost_revenue","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"sum"}},"reductions":{},"customisations":{"options":{},"axes":{},"channels":{"value":{"labelOverride":{"enabled":true,"value":"Revenue Lost (₹)"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"0"}}},"conditionalFormatting":[]},"chartType":"Number","meta":{},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"b39c7a69-76d0-4aaa-872d-d4977f3c2991"}},"item-7":{"title":"Order Loss Rate (%)","description":"DERIVED = orders with any lost revenue ÷ all orders × 100.","dashboardId":"dashboard-1","dataSourceId":"data-source-2","iconValue":"number","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[{"fieldPath":"lost_flag_pct","rawExpression":"{\n  \"$cond\": [\n    {\n      \"$gt\": [\n        {\n          \"$ifNull\": [\n            \"$lost_revenue\",\n            0\n          ]\n        },\n        0\n      ]\n    },\n    100,\n    0\n  ]\n}","derivedMQL":"{\"$cond\":[{\"$gt\":[{\"$ifNull\":[\"$lost_revenue\",0]},0]},100,0]}"}],"channels":{"value":{"field":"lost_flag_pct","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"mean"}},"reductions":{},"customisations":{"options":{},"axes":{},"channels":{"value":{"labelOverride":{"enabled":true,"value":"Order Loss Rate (%)"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"1"}}},"conditionalFormatting":[]},"chartType":"Number","meta":{},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"c89a2232-a091-4f9b-9ad2-8bb4ea9868fa"}},"item-8":{"title":"Open Alerts (all systems)","description":"BASE. Unresolved alerts from every system in one stream. Breakdown in 7.1.","dashboardId":"dashboard-1","dataSourceId":"data-source-3","iconValue":"number","itemType":"chart","filters":[{"fieldPath":"status","disabled":false,"type":"String","settings":{"allOthers":false,"values":["open"]}}],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[],"channels":{"value":{"field":"_id","type":"quantitative","inferredType":"String","channelType":"aggregation","aggregate":"count"}},"reductions":{},"customisations":{"options":{},"axes":{},"channels":{"value":{"labelOverride":{"enabled":true,"value":"Open Alerts (all systems)"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"0"}}},"conditionalFormatting":[]},"chartType":"Number","meta":{},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"9bed7964-e878-489c-a8cf-cbf3223c9756"}},"item-9":{"title":"1.1 Stream Throughput — Events per Minute by System","description":"BASE. Each cell = messages one system produced in that minute (IST). Proves all four systems are live simultaneously, and shows their relative volume: clickstream is always the loudest, payments the quietest, because one order generates many page views but only a few transactions.","dashboardId":"dashboard-1","dataSourceId":"data-source-1","iconValue":"heatmap","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[],"channels":{"x":{"field":"minute_ist","type":"nominal","inferredType":"String","transformedType":"String","channelType":"category"},"y":{"field":"source_system","type":"nominal","inferredType":"String","transformedType":"String","channelType":"category"},"color":{"field":"_id","type":"quantitative","inferredType":"String","channelType":"aggregation","aggregate":"count"}},"reductions":{},"customisations":{"options":{},"axes":{"x":{"categoryLabelAngle":{"enabled":true,"value":"diagonal"}}},"channels":{"x":{"labelOverride":{"enabled":true,"value":"Minute (IST)"}},"y":{"labelOverride":{"enabled":true,"value":"System"}},"color":{"labelOverride":{"enabled":true,"value":"Events"},"numberFormatting":{"enabled":true,"value":"Default"}}},"conditionalFormatting":[]},"chartType":"Heatmap","meta":{},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"c0b8848e-e4c9-4227-bd39-bfaa7064ee41"}},"item-10":{"title":"1.2 Message Volume by Kafka Topic","description":"BASE. Total messages carried by each of the 14 topics. A topic with zero traffic means a producer is down; a topic dominating the chart is the one to partition first if throughput becomes a problem.","dashboardId":"dashboard-1","dataSourceId":"data-source-1","iconValue":"bar-grouped","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[],"channels":{"y":{"field":"topic","type":"nominal","inferredType":"String","transformedType":"String","channelType":"category","isLimiting":true,"limitingSize":"14"},"x":{"field":"_id","type":"quantitative","inferredType":"String","channelType":"aggregation","aggregate":"count"}},"reductions":{},"customisations":{"options":{"dataValueLabels":{"enabled":true,"value":null},"colorDiscrete":{"enabled":true,"value":["#1392AB","#16CC62","#E6B219","#E6196E","#196EE6","#E65D19","#19C3E6","#116149","#80340E","#ABABAB","#73E0A1","#8CB6F2"]}},"axes":{},"channels":{"y":{"labelOverride":{"enabled":true,"value":"Topic"}},"x":{"labelOverride":{"enabled":true,"value":"Messages"},"numberFormatting":{"enabled":true,"value":"Default"}}},"conditionalFormatting":[]},"chartType":"Grouped Bar","meta":{},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"b8230f8e-0288-4873-ae3c-057dc6f2d6b8"}},"item-11":{"title":"1.3 Orders and Retained Revenue per Minute","description":"BASE → DERIVED. Bars = orders created per minute. Line = revenue retained per minute. When the bars hold steady but the line falls, volume is fine and something downstream — payments or stock — is eating the revenue.","dashboardId":"dashboard-1","dataSourceId":"data-source-2","iconValue":"combo-grouped","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[],"channels":{"x":{"field":"minute_ist","type":"nominal","inferredType":"String","transformedType":"String","channelType":"category"},"y":{"field":"_id","type":"quantitative","inferredType":"String","channelType":"aggregation","aggregate":"count"},"ylines":{"field":"retained_revenue","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"sum"}},"reductions":{},"customisations":{"options":{"dataMarkers":{"enabled":true,"value":null}},"axes":{"x":{"categoryLabelAngle":{"enabled":true,"value":"diagonal"}},"ylines2":{"labelOverride":{"enabled":true,"value":"Retained ₹"}}},"channels":{"x":{"labelOverride":{"enabled":true,"value":"Minute (IST)"}},"y":{"labelOverride":{"enabled":true,"value":"Orders"},"numberFormatting":{"enabled":true,"value":"Default"}},"ylines":{"labelOverride":{"enabled":true,"value":"Retained ₹"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"0"},"plotOnSecondaryAxis":{"enabled":true,"value":null}}},"conditionalFormatting":[]},"chartType":"Grouped Combo","meta":{},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"61d36928-db7a-4ade-baac-d609aa1068d2"}},"item-12":{"title":"2.1 Session Funnel — Furthest Stage Reached","description":"BASE. Each session counted once, at the deepest stage it reached. The drop between adjacent bars is where shoppers are lost; the gap between 'Added to cart' and 'Checked out' is recoverable demand.","dashboardId":"dashboard-1","dataSourceId":"data-source-4","iconValue":"bar-grouped","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[{"fieldPath":"funnel_stage_label","rawExpression":"{\n  \"$switch\": {\n    \"branches\": [\n      {\n        \"case\": {\n          \"$eq\": [\n            \"$funnel_stage\",\n            \"view\"\n          ]\n        },\n        \"then\": \"1. Viewed\"\n      },\n      {\n        \"case\": {\n          \"$eq\": [\n            \"$funnel_stage\",\n            \"search\"\n          ]\n        },\n        \"then\": \"2. Searched\"\n      },\n      {\n        \"case\": {\n          \"$eq\": [\n            \"$funnel_stage\",\n            \"click\"\n          ]\n        },\n        \"then\": \"3. Clicked product\"\n      },\n      {\n        \"case\": {\n          \"$eq\": [\n            \"$funnel_stage\",\n            \"cart\"\n          ]\n        },\n        \"then\": \"4. Added to cart\"\n      },\n      {\n        \"case\": {\n          \"$eq\": [\n            \"$funnel_stage\",\n            \"checkout\"\n          ]\n        },\n        \"then\": \"5. Checked out\"\n      }\n    ],\n    \"default\": \"Other\"\n  }\n}","derivedMQL":"{\"$switch\":{\"branches\":[{\"case\":{\"$eq\":[\"$funnel_stage\",\"view\"]},\"then\":\"1. Viewed\"},{\"case\":{\"$eq\":[\"$funnel_stage\",\"search\"]},\"then\":\"2. Searched\"},{\"case\":{\"$eq\":[\"$funnel_stage\",\"click\"]},\"then\":\"3. Clicked product\"},{\"case\":{\"$eq\":[\"$funnel_stage\",\"cart\"]},\"then\":\"4. Added to cart\"},{\"case\":{\"$eq\":[\"$funnel_stage\",\"checkout\"]},\"then\":\"5. Checked out\"}],\"default\":\"Other\"}}"}],"channels":{"y":{"field":"funnel_stage_label","type":"nominal","inferredType":"String","transformedType":"String","channelType":"category"},"x":{"field":"_id","type":"quantitative","inferredType":"String","channelType":"aggregation","aggregate":"count"}},"reductions":{},"customisations":{"options":{"dataValueLabels":{"enabled":true,"value":null},"colorDiscrete":{"enabled":true,"value":["#1392AB","#16CC62","#E6B219","#E6196E","#196EE6","#E65D19","#19C3E6","#116149","#80340E","#ABABAB","#73E0A1","#8CB6F2"]}},"axes":{},"channels":{"y":{"labelOverride":{"enabled":true,"value":"Funnel stage"}},"x":{"labelOverride":{"enabled":true,"value":"Sessions"},"numberFormatting":{"enabled":true,"value":"Default"}}},"conditionalFormatting":[]},"chartType":"Grouped Bar","meta":{},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"cf6add06-c445-439c-9b72-a77d0facbd5b"}},"item-13":{"title":"2.2 Conversion by Device (%)","description":"DERIVED from 2.1 = share of that device's sessions reaching each stage × 100. Absolute counts hide device problems; rates expose them — a mobile checkout rate far below desktop is a UX defect, not a traffic problem.","dashboardId":"dashboard-1","dataSourceId":"data-source-4","iconValue":"data-table","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[{"fieldPath":"pct_reached_click","rawExpression":"{\n  \"$multiply\": [\n    {\n      \"$ifNull\": [\n        \"$reached_click\",\n        0\n      ]\n    },\n    100\n  ]\n}","derivedMQL":"{\"$multiply\":[{\"$ifNull\":[\"$reached_click\",0]},100]}"},{"fieldPath":"pct_reached_cart","rawExpression":"{\n  \"$multiply\": [\n    {\n      \"$ifNull\": [\n        \"$reached_cart\",\n        0\n      ]\n    },\n    100\n  ]\n}","derivedMQL":"{\"$multiply\":[{\"$ifNull\":[\"$reached_cart\",0]},100]}"},{"fieldPath":"pct_reached_checkout","rawExpression":"{\n  \"$multiply\": [\n    {\n      \"$ifNull\": [\n        \"$reached_checkout\",\n        0\n      ]\n    },\n    100\n  ]\n}","derivedMQL":"{\"$multiply\":[{\"$ifNull\":[\"$reached_checkout\",0]},100]}"}],"channels":{"group":{"field":"device","type":"nominal","inferredType":"String","transformedType":"String","channelType":"category"},"value":{"field":"_id","type":"quantitative","inferredType":"String","channelType":"aggregation","aggregate":"count"},"value_series_0":{"field":"pct_reached_click","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"mean"},"value_series_1":{"field":"pct_reached_cart","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"mean"},"value_series_2":{"field":"pct_reached_checkout","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"mean"}},"reductions":{},"customisations":{"options":{"totalsColumn":{"enabled":false,"value":null}},"axes":{},"channels":{"group":{"labelOverride":{"enabled":true,"value":"Device"}},"value":{"labelOverride":{"enabled":true,"value":"Sessions"},"numberFormatting":{"enabled":true,"value":"Default"}},"value_series_0":{"labelOverride":{"enabled":true,"value":"Reached click %"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"1"}},"value_series_1":{"labelOverride":{"enabled":true,"value":"Reached cart %"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"1"}},"value_series_2":{"labelOverride":{"enabled":true,"value":"Checked out %"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"1"}}},"conditionalFormatting":[{"type":"continuous","conditions":[{"target":{"type":"CHANNEL","value":"value_series_2"},"operator":"","value":""}],"applyToEntireRow":false,"styling":{"backgroundColor":"mdbredwhitegreen","reverse":false}}]},"chartType":"Data Table","meta":{"sortModel":[{"colId":"value","sort":"desc"}]},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"a86225f6-58e3-4326-b030-0f0f4f81fb73"}},"item-14":{"title":"2.3 Checkout Conversion by Acquisition Channel (%)","description":"DERIVED = sessions from that channel reaching checkout ÷ sessions from that channel × 100. Spend should follow this chart, not raw traffic.","dashboardId":"dashboard-1","dataSourceId":"data-source-4","iconValue":"bar-grouped","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[{"fieldPath":"pct_reached_checkout","rawExpression":"{\n  \"$multiply\": [\n    {\n      \"$ifNull\": [\n        \"$reached_checkout\",\n        0\n      ]\n    },\n    100\n  ]\n}","derivedMQL":"{\"$multiply\":[{\"$ifNull\":[\"$reached_checkout\",0]},100]}"}],"channels":{"y":{"field":"channel","type":"nominal","inferredType":"String","transformedType":"String","channelType":"category"},"x":{"field":"pct_reached_checkout","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"mean"}},"reductions":{},"customisations":{"options":{"dataValueLabels":{"enabled":true,"value":null},"colorDiscrete":{"enabled":true,"value":["#1392AB","#16CC62","#E6B219","#E6196E","#196EE6","#E65D19","#19C3E6","#116149","#80340E","#ABABAB","#73E0A1","#8CB6F2"]}},"axes":{},"channels":{"y":{"labelOverride":{"enabled":true,"value":"Channel"}},"x":{"labelOverride":{"enabled":true,"value":"Checkout rate %"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"1"}}},"conditionalFormatting":[]},"chartType":"Grouped Bar","meta":{},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"7a5c75bd-a7e0-41da-83ae-8a52d0162297"}},"item-15":{"title":"2.4 Cart Outcomes","description":"BASE. Every cart ends in one of four states. 'Abandoned' is assigned by the consumer's background watcher when a cart sits idle past the timeout — a decision only a streaming system can make, because it is triggered by the absence of an event.","dashboardId":"dashboard-1","dataSourceId":"data-source-5","iconValue":"donut","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[],"channels":{"label":{"field":"status","type":"nominal","inferredType":"String","transformedType":"String","channelType":"category"},"value":{"field":"_id","type":"quantitative","inferredType":"String","channelType":"aggregation","aggregate":"count"}},"reductions":{},"customisations":{"options":{"colorDiscrete":{"enabled":true,"value":["#1392AB","#16CC62","#E6B219","#E6196E","#196EE6","#E65D19","#19C3E6","#116149","#80340E","#ABABAB","#73E0A1","#8CB6F2"]}},"axes":{},"channels":{"label":{"labelOverride":{"enabled":true,"value":"Cart status"}},"value":{"labelOverride":{"enabled":true,"value":"Carts"},"numberFormatting":{"enabled":true,"value":"Default"}}},"conditionalFormatting":[]},"chartType":"Donut","meta":{},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"b0928049-3d15-4af1-b1a5-2e09d5b3bcf9"}},"item-16":{"title":"2.5 Abandoned Cart Value by Category (₹)","description":"DERIVED from 2.4 = cart value of abandoned carts only. This is live recoverable revenue — the list a retargeting campaign should be built from within minutes, not tomorrow.","dashboardId":"dashboard-1","dataSourceId":"data-source-5","iconValue":"bar-grouped","itemType":"chart","filters":[{"fieldPath":"status","disabled":false,"type":"String","settings":{"allOthers":false,"values":["abandoned"]}}],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[],"channels":{"y":{"field":"category","type":"nominal","inferredType":"String","transformedType":"String","channelType":"category"},"x":{"field":"cart_value","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"sum"}},"reductions":{},"customisations":{"options":{"dataValueLabels":{"enabled":true,"value":null},"colorDiscrete":{"enabled":true,"value":["#1392AB","#16CC62","#E6B219","#E6196E","#196EE6","#E65D19","#19C3E6","#116149","#80340E","#ABABAB","#73E0A1","#8CB6F2"]}},"axes":{},"channels":{"y":{"labelOverride":{"enabled":true,"value":"Category"}},"x":{"labelOverride":{"enabled":true,"value":"Abandoned value ₹"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"0"}}},"conditionalFormatting":[]},"chartType":"Grouped Bar","meta":{},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"ef37595c-57d0-4e79-a24d-b0fb5b12e63f"}},"item-17":{"title":"2.6 Demand With No Catalog Cover","description":"BASE. Search terms that returned zero results, counted. Each one is a customer who wanted to spend money and found nothing — the cheapest assortment signal in the business.","dashboardId":"dashboard-1","dataSourceId":"data-source-6","iconValue":"bar-grouped","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[],"channels":{"y":{"field":"search_term","type":"nominal","inferredType":"String","transformedType":"String","channelType":"category","isLimiting":true,"limitingSize":"12"},"x":{"field":"zero_result_count","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"sum"}},"reductions":{},"customisations":{"options":{"dataValueLabels":{"enabled":true,"value":null},"colorDiscrete":{"enabled":true,"value":["#1392AB","#16CC62","#E6B219","#E6196E","#196EE6","#E65D19","#19C3E6","#116149","#80340E","#ABABAB","#73E0A1","#8CB6F2"]}},"axes":{},"channels":{"y":{"labelOverride":{"enabled":true,"value":"Search term"}},"x":{"labelOverride":{"enabled":true,"value":"Zero-result searches"},"numberFormatting":{"enabled":true,"value":"Default"}}},"conditionalFormatting":[]},"chartType":"Grouped Bar","meta":{},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"fdbc5d12-efe4-4fed-9b42-e58bb76f0155"}},"item-18":{"title":"3.1 Where Every Order Ends Up","description":"BASE. Outcome of each order, from the journey_orders collection that joins all four systems. An order is only 'kept' if the clickstream produced it, the OMS accepted it, the PMS collected the money, the IMS shipped the stock and it was not returned.","dashboardId":"dashboard-1","dataSourceId":"data-source-2","iconValue":"donut","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[{"fieldPath":"outcome_label","rawExpression":"{\n  \"$switch\": {\n    \"branches\": [\n      {\n        \"case\": {\n          \"$eq\": [\n            \"$outcome\",\n            \"DELIVERED\"\n          ]\n        },\n        \"then\": \"Delivered (revenue kept)\"\n      },\n      {\n        \"case\": {\n          \"$eq\": [\n            \"$outcome\",\n            \"RETURNED\"\n          ]\n        },\n        \"then\": \"Returned (lost after delivery)\"\n      },\n      {\n        \"case\": {\n          \"$eq\": [\n            \"$outcome\",\n            \"CANCELLED_PAYMENT\"\n          ]\n        },\n        \"then\": \"Cancelled \\u2014 payment failed\"\n      },\n      {\n        \"case\": {\n          \"$eq\": [\n            \"$outcome\",\n            \"CANCELLED_STOCKOUT\"\n          ]\n        },\n        \"then\": \"Cancelled \\u2014 out of stock\"\n      }\n    ],\n    \"default\": \"In progress\"\n  }\n}","derivedMQL":"{\"$switch\":{\"branches\":[{\"case\":{\"$eq\":[\"$outcome\",\"DELIVERED\"]},\"then\":\"Delivered (revenue kept)\"},{\"case\":{\"$eq\":[\"$outcome\",\"RETURNED\"]},\"then\":\"Returned (lost after delivery)\"},{\"case\":{\"$eq\":[\"$outcome\",\"CANCELLED_PAYMENT\"]},\"then\":\"Cancelled \\u2014 payment failed\"},{\"case\":{\"$eq\":[\"$outcome\",\"CANCELLED_STOCKOUT\"]},\"then\":\"Cancelled \\u2014 out of stock\"}],\"default\":\"In progress\"}}"}],"channels":{"label":{"field":"outcome_label","type":"nominal","inferredType":"String","transformedType":"String","channelType":"category"},"value":{"field":"order_value","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"sum"}},"reductions":{},"customisations":{"options":{"colorDiscrete":{"enabled":true,"value":["#1392AB","#16CC62","#E6B219","#E6196E","#196EE6","#E65D19","#19C3E6","#116149","#80340E","#ABABAB","#73E0A1","#8CB6F2"]}},"axes":{},"channels":{"label":{"labelOverride":{"enabled":true,"value":"Outcome"}},"value":{"labelOverride":{"enabled":true,"value":"Order value ₹"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"0"}}},"conditionalFormatting":[]},"chartType":"Donut","meta":{},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"b36a1743-3758-4d19-ac48-edef35a88380"}},"item-19":{"title":"3.2 Lost Revenue by Root Cause — Which System Is Responsible","description":"DERIVED from 3.1 = lost revenue grouped by the cause recorded at cancellation. This is the chart that only exists because the systems are joined: payment failure is a PMS problem, stock-out is an IMS problem, returns are a product-quality problem. Each points at a different team.","dashboardId":"dashboard-1","dataSourceId":"data-source-2","iconValue":"bar-grouped","itemType":"chart","filters":[{"fieldPath":"lost_revenue","disabled":false,"type":"Number","settings":{"min":{"enabled":true,"inclusive":true,"value":"1"},"max":{"enabled":false,"inclusive":true,"value":""}}}],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[{"fieldPath":"outcome_label","rawExpression":"{\n  \"$switch\": {\n    \"branches\": [\n      {\n        \"case\": {\n          \"$eq\": [\n            \"$outcome\",\n            \"DELIVERED\"\n          ]\n        },\n        \"then\": \"Delivered (revenue kept)\"\n      },\n      {\n        \"case\": {\n          \"$eq\": [\n            \"$outcome\",\n            \"RETURNED\"\n          ]\n        },\n        \"then\": \"Returned (lost after delivery)\"\n      },\n      {\n        \"case\": {\n          \"$eq\": [\n            \"$outcome\",\n            \"CANCELLED_PAYMENT\"\n          ]\n        },\n        \"then\": \"Cancelled \\u2014 payment failed\"\n      },\n      {\n        \"case\": {\n          \"$eq\": [\n            \"$outcome\",\n            \"CANCELLED_STOCKOUT\"\n          ]\n        },\n        \"then\": \"Cancelled \\u2014 out of stock\"\n      }\n    ],\n    \"default\": \"In progress\"\n  }\n}","derivedMQL":"{\"$switch\":{\"branches\":[{\"case\":{\"$eq\":[\"$outcome\",\"DELIVERED\"]},\"then\":\"Delivered (revenue kept)\"},{\"case\":{\"$eq\":[\"$outcome\",\"RETURNED\"]},\"then\":\"Returned (lost after delivery)\"},{\"case\":{\"$eq\":[\"$outcome\",\"CANCELLED_PAYMENT\"]},\"then\":\"Cancelled \\u2014 payment failed\"},{\"case\":{\"$eq\":[\"$outcome\",\"CANCELLED_STOCKOUT\"]},\"then\":\"Cancelled \\u2014 out of stock\"}],\"default\":\"In progress\"}}"}],"channels":{"y":{"field":"outcome_label","type":"nominal","inferredType":"String","transformedType":"String","channelType":"category"},"x":{"field":"lost_revenue","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"sum"}},"reductions":{},"customisations":{"options":{"dataValueLabels":{"enabled":true,"value":null},"colorDiscrete":{"enabled":true,"value":["#1392AB","#16CC62","#E6B219","#E6196E","#196EE6","#E65D19","#19C3E6","#116149","#80340E","#ABABAB","#73E0A1","#8CB6F2"]}},"axes":{},"channels":{"y":{"labelOverride":{"enabled":true,"value":"Outcome"}},"x":{"labelOverride":{"enabled":true,"value":"Lost revenue ₹"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"0"}}},"conditionalFormatting":[]},"chartType":"Grouped Bar","meta":{},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"143a6694-f531-40af-82a2-c15d377f59cf"}},"item-20":{"title":"3.3 Category Scorecard — Volume, Value and Leakage","description":"BASE → DERIVED. Orders and order value per category (base), then revenue retained, revenue lost and loss rate % (derived). Sorted by lost revenue: the top row is where the money is going.","dashboardId":"dashboard-1","dataSourceId":"data-source-2","iconValue":"data-table","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[{"fieldPath":"lost_flag_pct","rawExpression":"{\n  \"$cond\": [\n    {\n      \"$gt\": [\n        {\n          \"$ifNull\": [\n            \"$lost_revenue\",\n            0\n          ]\n        },\n        0\n      ]\n    },\n    100,\n    0\n  ]\n}","derivedMQL":"{\"$cond\":[{\"$gt\":[{\"$ifNull\":[\"$lost_revenue\",0]},0]},100,0]}"}],"channels":{"group":{"field":"category","type":"nominal","inferredType":"String","transformedType":"String","channelType":"category"},"value":{"field":"_id","type":"quantitative","inferredType":"String","channelType":"aggregation","aggregate":"count"},"value_series_0":{"field":"order_value","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"sum"},"value_series_1":{"field":"retained_revenue","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"sum"},"value_series_2":{"field":"lost_revenue","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"sum"},"value_series_3":{"field":"lost_flag_pct","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"mean"}},"reductions":{},"customisations":{"options":{"totalsColumn":{"enabled":false,"value":null}},"axes":{},"channels":{"group":{"labelOverride":{"enabled":true,"value":"Category"}},"value":{"labelOverride":{"enabled":true,"value":"Orders"},"numberFormatting":{"enabled":true,"value":"Default"}},"value_series_0":{"labelOverride":{"enabled":true,"value":"Order value ₹"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"0"}},"value_series_1":{"labelOverride":{"enabled":true,"value":"Retained ₹"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"0"}},"value_series_2":{"labelOverride":{"enabled":true,"value":"Lost ₹"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"0"}},"value_series_3":{"labelOverride":{"enabled":true,"value":"Loss rate %"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"1"}}},"conditionalFormatting":[{"type":"continuous","conditions":[{"target":{"type":"CHANNEL","value":"value_series_2"},"operator":"","value":""}],"applyToEntireRow":false,"styling":{"backgroundColor":"mdbredwhitegreen","reverse":true}}]},"chartType":"Data Table","meta":{"sortModel":[{"colId":"value_series_2","sort":"desc"}]},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"63978472-af15-41fa-b385-a9a6ba97e9ee"}},"item-21":{"title":"3.4 Order Loss Rate by Fulfilment Warehouse (%)","description":"DERIVED = orders with lost revenue ÷ orders routed to that warehouse × 100. Normalises for warehouse size, so a small warehouse with a stock problem is not hidden by a large healthy one.","dashboardId":"dashboard-1","dataSourceId":"data-source-2","iconValue":"bar-grouped","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[{"fieldPath":"lost_flag_pct","rawExpression":"{\n  \"$cond\": [\n    {\n      \"$gt\": [\n        {\n          \"$ifNull\": [\n            \"$lost_revenue\",\n            0\n          ]\n        },\n        0\n      ]\n    },\n    100,\n    0\n  ]\n}","derivedMQL":"{\"$cond\":[{\"$gt\":[{\"$ifNull\":[\"$lost_revenue\",0]},0]},100,0]}"}],"channels":{"y":{"field":"warehouse_id","type":"nominal","inferredType":"String","transformedType":"String","channelType":"category"},"x":{"field":"lost_flag_pct","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"mean"}},"reductions":{},"customisations":{"options":{"dataValueLabels":{"enabled":true,"value":null},"colorDiscrete":{"enabled":true,"value":["#1392AB","#16CC62","#E6B219","#E6196E","#196EE6","#E65D19","#19C3E6","#116149","#80340E","#ABABAB","#73E0A1","#8CB6F2"]}},"axes":{},"channels":{"y":{"labelOverride":{"enabled":true,"value":"Warehouse"}},"x":{"labelOverride":{"enabled":true,"value":"Loss rate %"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"1"}}},"conditionalFormatting":[]},"chartType":"Grouped Bar","meta":{},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"22d9c79e-a4e6-4693-b197-d522913869b7"}},"item-22":{"title":"4.1 Payment Attempts by Method and Outcome","description":"BASE. Every gateway attempt, split by result. An order that fails twice and succeeds contributes three attempts here — which is why attempt counts exceed order counts.","dashboardId":"dashboard-1","dataSourceId":"data-source-7","iconValue":"bar-stacked","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[],"channels":{"y":{"field":"payment_method","type":"nominal","inferredType":"String","transformedType":"String","channelType":"category"},"x":{"field":"_id","type":"quantitative","inferredType":"String","channelType":"aggregation","aggregate":"count"},"color":{"field":"transaction_status","type":"nominal","inferredType":"String","transformedType":"String","channelType":"category"}},"reductions":{},"customisations":{"options":{"colorDiscrete":{"enabled":true,"value":["#1392AB","#16CC62","#E6B219","#E6196E","#196EE6","#E65D19","#19C3E6","#116149","#80340E","#ABABAB","#73E0A1","#8CB6F2"]}},"axes":{},"channels":{"y":{"labelOverride":{"enabled":true,"value":"Payment method"}},"x":{"labelOverride":{"enabled":true,"value":"Attempts"},"numberFormatting":{"enabled":true,"value":"Default"}},"color":{"labelOverride":{"enabled":true,"value":"Outcome"}}},"conditionalFormatting":[]},"chartType":"Stacked Bar","meta":{},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"dcf30e0b-8a0a-42da-bef6-0db4a1c42442"}},"item-23":{"title":"4.2 Failure Rate by Gateway (%)","description":"DERIVED from 4.1 = failed or declined attempts ÷ all attempts for that gateway × 100. One gateway spiking while the others hold steady is an outage, not fraud — and the fix is to reroute traffic, not to block customers.","dashboardId":"dashboard-1","dataSourceId":"data-source-7","iconValue":"bar-grouped","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[{"fieldPath":"txn_failed_pct","rawExpression":"{\n  \"$cond\": [\n    {\n      \"$in\": [\n        \"$transaction_status\",\n        [\n          \"FAILED\",\n          \"DECLINED\"\n        ]\n      ]\n    },\n    100,\n    0\n  ]\n}","derivedMQL":"{\"$cond\":[{\"$in\":[\"$transaction_status\",[\"FAILED\",\"DECLINED\"]]},100,0]}"}],"channels":{"y":{"field":"payment_gateway","type":"nominal","inferredType":"String","transformedType":"String","channelType":"category"},"x":{"field":"txn_failed_pct","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"mean"}},"reductions":{},"customisations":{"options":{"dataValueLabels":{"enabled":true,"value":null},"colorDiscrete":{"enabled":true,"value":["#1392AB","#16CC62","#E6B219","#E6196E","#196EE6","#E65D19","#19C3E6","#116149","#80340E","#ABABAB","#73E0A1","#8CB6F2"]}},"axes":{},"channels":{"y":{"labelOverride":{"enabled":true,"value":"Gateway"}},"x":{"labelOverride":{"enabled":true,"value":"Failure rate %"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"1"}}},"conditionalFormatting":[]},"chartType":"Grouped Bar","meta":{},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"beec96c4-b862-45a4-b826-a9ccc451de04"}},"item-24":{"title":"4.3 Why Payments Fail","description":"BASE. Declared failure reason on every failed or declined attempt. Explains the rates in 4.2 and separates customer-side causes (insufficient funds) from infrastructure ones (gateway timeout).","dashboardId":"dashboard-1","dataSourceId":"data-source-7","iconValue":"bar-grouped","itemType":"chart","filters":[{"fieldPath":"transaction_status","disabled":false,"type":"String","settings":{"allOthers":false,"values":["FAILED","DECLINED"]}}],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[],"channels":{"y":{"field":"failure_reason","type":"nominal","inferredType":"String","transformedType":"String","channelType":"category"},"x":{"field":"_id","type":"quantitative","inferredType":"String","channelType":"aggregation","aggregate":"count"}},"reductions":{},"customisations":{"options":{"dataValueLabels":{"enabled":true,"value":null},"colorDiscrete":{"enabled":true,"value":["#1392AB","#16CC62","#E6B219","#E6196E","#196EE6","#E65D19","#19C3E6","#116149","#80340E","#ABABAB","#73E0A1","#8CB6F2"]}},"axes":{},"channels":{"y":{"labelOverride":{"enabled":true,"value":"Failure reason"}},"x":{"labelOverride":{"enabled":true,"value":"Failed attempts"},"numberFormatting":{"enabled":true,"value":"Default"}}},"conditionalFormatting":[]},"chartType":"Grouped Bar","meta":{},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"b0aa90a7-a228-4265-ac20-5584880ca045"}},"item-25":{"title":"4.4 Fraud Detection Quality — Rules vs Ground Truth","description":"DERIVED. The producer tags every synthetic fraud transaction with its true type; the consumer's rules never see that tag. Grouping flagged % by true type measures RECALL per fraud pattern, and the 'Not fraud' row is the false-positive rate. Counting alerts alone would tell you neither.","dashboardId":"dashboard-1","dataSourceId":"data-source-8","iconValue":"data-table","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[{"fieldPath":"fraud_type_label","rawExpression":"{\n  \"$ifNull\": [\n    \"$fraud_type_ground_truth\",\n    \"Not fraud (normal)\"\n  ]\n}","derivedMQL":"{\"$ifNull\":[\"$fraud_type_ground_truth\",\"Not fraud (normal)\"]}"},{"fieldPath":"flagged_pct","rawExpression":"{\n  \"$cond\": [\n    {\n      \"$eq\": [\n        {\n          \"$ifNull\": [\n            \"$flagged\",\n            false\n          ]\n        },\n        true\n      ]\n    },\n    100,\n    0\n  ]\n}","derivedMQL":"{\"$cond\":[{\"$eq\":[{\"$ifNull\":[\"$flagged\",false]},true]},100,0]}"}],"channels":{"group":{"field":"fraud_type_label","type":"nominal","inferredType":"String","transformedType":"String","channelType":"category"},"value":{"field":"_id","type":"quantitative","inferredType":"String","channelType":"aggregation","aggregate":"count"},"value_series_0":{"field":"flagged_pct","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"mean"},"value_series_1":{"field":"amount","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"sum"}},"reductions":{},"customisations":{"options":{"totalsColumn":{"enabled":false,"value":null}},"axes":{},"channels":{"group":{"labelOverride":{"enabled":true,"value":"Fraud type"}},"value":{"labelOverride":{"enabled":true,"value":"Orders"},"numberFormatting":{"enabled":true,"value":"Default"}},"value_series_0":{"labelOverride":{"enabled":true,"value":"Caught by rules %"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"1"}},"value_series_1":{"labelOverride":{"enabled":true,"value":"Value at risk ₹"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"0"}}},"conditionalFormatting":[{"type":"continuous","conditions":[{"target":{"type":"CHANNEL","value":"value_series_0"},"operator":"","value":""}],"applyToEntireRow":false,"styling":{"backgroundColor":"mdbredwhitegreen","reverse":false}}]},"chartType":"Data Table","meta":{"sortModel":[{"colId":"value","sort":"desc"}]},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"6088a481-d829-46d4-8dc0-5a1e6016bbd7"}},"item-26":{"title":"5.1 Stock Ledger by SKU","description":"BASE → DERIVED. Units issued and received per SKU (base), then current on-hand and the LOWEST available level ever reached (derived). Current stock alone lies — a SKU sitting at 30 units today may have hit zero an hour ago and cost you orders. Sorted by that low-water mark.","dashboardId":"dashboard-1","dataSourceId":"data-source-9","iconValue":"data-table","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[],"channels":{"group":{"field":"sku","type":"nominal","inferredType":"String","transformedType":"String","channelType":"category","isLimiting":true,"limitingSize":"20"},"value":{"field":"units_out","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"sum"},"value_series_0":{"field":"units_in","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"sum"},"value_series_1":{"field":"on_hand","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"sum"},"value_series_2":{"field":"lowest_available","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"min"},"value_series_3":{"field":"stockout_episodes","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"sum"}},"reductions":{},"customisations":{"options":{"totalsColumn":{"enabled":false,"value":null}},"axes":{},"channels":{"group":{"labelOverride":{"enabled":true,"value":"SKU"}},"value":{"labelOverride":{"enabled":true,"value":"Units out"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"0"}},"value_series_0":{"labelOverride":{"enabled":true,"value":"Units in"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"0"}},"value_series_1":{"labelOverride":{"enabled":true,"value":"On hand now"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"0"}},"value_series_2":{"labelOverride":{"enabled":true,"value":"Lowest available"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"0"}},"value_series_3":{"labelOverride":{"enabled":true,"value":"Stock-out episodes"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"0"}}},"conditionalFormatting":[{"type":"continuous","conditions":[{"target":{"type":"CHANNEL","value":"value_series_2"},"operator":"","value":""}],"applyToEntireRow":false,"styling":{"backgroundColor":"mdbredwhitegreen","reverse":false}},{"type":"discrete","conditions":[{"target":{"value":"value_series_3","type":"CHANNEL"},"operator":"NUMBER_GREATER_THAN","value":"0"}],"applyToEntireRow":false,"styling":{"color":"rgb(193, 4, 34)","backgroundColor":"rgba(0, 0, 0, 0)","fontStyle":"normal","fontWeight":"bold","textDecoration":"initial"}}]},"chartType":"Data Table","meta":{"sortModel":[{"colId":"value_series_2","sort":"asc"}]},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"76e058fa-b832-45e2-9b78-0f5a6bf404fa"}},"item-27":{"title":"5.2 Stock-Out Exposure by SKU (%)","description":"DERIVED from 5.1 = share of a SKU's warehouse positions that reached zero available stock. 100% means the item was unsellable everywhere at once — the reorder list, ranked.","dashboardId":"dashboard-1","dataSourceId":"data-source-9","iconValue":"bar-grouped","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[{"fieldPath":"stockout_flag_pct","rawExpression":"{\n  \"$cond\": [\n    {\n      \"$lte\": [\n        {\n          \"$ifNull\": [\n            \"$lowest_available\",\n            999\n          ]\n        },\n        0\n      ]\n    },\n    100,\n    0\n  ]\n}","derivedMQL":"{\"$cond\":[{\"$lte\":[{\"$ifNull\":[\"$lowest_available\",999]},0]},100,0]}"}],"channels":{"y":{"field":"sku","type":"nominal","inferredType":"String","transformedType":"String","channelType":"category","isLimiting":true,"limitingSize":"15"},"x":{"field":"stockout_flag_pct","type":"quantitative","inferredType":"Number","cha