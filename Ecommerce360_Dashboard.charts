ate":"mean"},"value_series_2":{"field":"secs_paid_to_shipped","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"mean"},"value_series_3":{"field":"secs_shipped_to_delivered","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"mean"},"value_series_4":{"field":"secs_total","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"mean"}},"reductions":{},"customisations":{"options":{"totalsColumn":{"enabled":false,"value":null}},"axes":{},"channels":{"group":{"labelOverride":{"enabled":true,"value":"Warehouse"}},"value":{"labelOverride":{"enabled":true,"value":"Orders"},"numberFormatting":{"enabled":true,"value":"Default"}},"value_series_0":{"labelOverride":{"enabled":true,"value":"Browse→Checkout"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"1"}},"value_series_1":{"labelOverride":{"enabled":true,"value":"Checkout→Paid"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"1"}},"value_series_2":{"labelOverride":{"enabled":true,"value":"Paid→Shipped"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"1"}},"value_series_3":{"labelOverride":{"enabled":true,"value":"Shipped→Delivered"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"1"}},"value_series_4":{"labelOverride":{"enabled":true,"value":"Total"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"1"}}},"conditionalFormatting":[{"type":"continuous","conditions":[{"target":{"type":"CHANNEL","value":"value_series_4"},"operator":"","value":""}],"applyToEntireRow":false,"styling":{"backgroundColor":"mdbredwhitegreen","reverse":true}},{"type":"continuous","conditions":[{"target":{"type":"CHANNEL","value":"value_series_2"},"operator":"","value":""}],"applyToEntireRow":false,"styling":{"backgroundColo