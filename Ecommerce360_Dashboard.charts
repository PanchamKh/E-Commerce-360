","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[],"channels":{"y":{"field":"alert_type","type":"nominal","inferredType":"String","transformedType":"String","channelType":"category","isLimiting":true,"limitingSize":"15"},"x":{"field":"_id","type":"quantitative","inferredType":"String","channelType":"aggregation","aggregate":"count"},"color":{"field":"severity","type":"nominal","inferredType":"String","transformedType":"String","channelType":"category"}},"reductions":{},"customisations":{"options":{"colorDiscrete":{"enabled":true,"value":["#1392AB","#16CC62","#E6B219","#E6196E","#196EE6","#E65D19","#19C3E6","#116149","#80340E","#ABABAB","#73E0A1","#8CB6F2"]}},"axes":{},"channels":{"y":{"labelOverride":{"enabled":true,"value":"Alert type"}},"x":{"labelOverride":{"enabled":true,"value":"Alerts"},"numberFormatting":{"enabled":true,"value":"Default"}},"color":{"labelOverride":{"enabled":true,"value":"Severity"}}},"conditionalFormatting":[]},"chartType":"Stacked Bar","meta":{},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"210a488c-5628-4104-863e-f3e8e17995d4"}},"item-33":{"title":"7.2 Alert Pressure per Minute by System","description":"DERIVED from 7.1 and 1.1 = alerts per minute per system. A burst in one row while the others stay quiet localises the incident immediately — and tells the on-call which system to open first.","dashboardId":"dashboard-1","dataSourceId":"data-source-3","iconValue":"heatmap","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[],"channels":{"x":{"field":"minute_ist","type":"nominal","inferredType":"String","transformedType":"String","channelType":"category"},"y":{"field":"source_system","type":"nominal","inferredType":"String","transformedType":"String","channelType":"category"},"color":{"field":"_id","type":"quantitative","inferredType":"String","channelType":"aggregation","ag